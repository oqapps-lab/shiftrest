EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Adapty — public SDK key (read-only, safe to ship in app binary)
# Get from https://app.adapty.io → ShiftSleep app → Settings → SDK keys
EXPO_PUBLIC_ADAPTY_PUBLIC_KEY=

# AppsFlyer — dev key (one per account, used to init SDK)
# Get from https://hq1.appsflyer.com → app settings → Dev Key
EXPO_PUBLIC_APPSFLYER_DEV_KEY=
EXPO_PUBLIC_APPSFLYER_APP_ID=
